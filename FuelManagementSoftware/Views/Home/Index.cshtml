@{
    ViewData["Title"] = "Home";
}

@using Microsoft.AspNetCore.Identity
@using FuelManagementSoftware.Constants
@if (User.Identity?.IsAuthenticated == true)
{
    var isOrg = !User.IsInRole(AppRoles.Customer);
    <div class="dashboard">
        <div class="dashboard-header mb-3">
            <h1 class="dashboard-title">Dashboard</h1>
            <p class="dashboard-subtitle text-muted mb-0">@(isOrg ? "PetroChain fuel management overview" : "Your fuel and transactions")</p>
        </div>

        <div class="dashboard-quicklinks mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small me-1">Quick access:</span>
                <a asp-controller="FuelDispensing" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-fuel-pump me-1"></i>Dispensing</a>
                <a asp-controller="FuelAvailability" asp-action="Index" class="btn btn-outline-success btn-sm"><i class="bi bi-list-ul me-1"></i>Availability</a>
                <a asp-controller="FuelAvailability" asp-action="Map" class="btn btn-outline-success btn-sm"><i class="bi bi-map me-1"></i>Map</a>
                <a asp-controller="PetroCard" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-credit-card me-1"></i>@(isOrg ? "PetroCards" : "My Cards")</a>
                <a asp-controller="FuelTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-receipt me-1"></i>@(isOrg ? "Transactions" : "My Transactions")</a>
                @if (isOrg)
                {
                    <a asp-controller="FuelStation" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-building me-1"></i>Stations</a>
                    <a asp-controller="FuelPump" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-droplet me-1"></i>Pumps</a>
                    <a asp-controller="BlockchainTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-shield-check me-1"></i>Secured Records</a>
                }
                <a asp-area="" asp-controller="Home" asp-action="Manual" class="btn btn-outline-secondary btn-sm"><i class="bi bi-book me-1"></i>Manual</a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-primary bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-credit-card text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">@(isOrg ? "PetroCards" : "My Cards")</h5>
                                <p class="card-text text-muted small mb-3">@(isOrg ? "Manage prepaid smart cards for fuel dispensing." : "View and use your PetroCards for fuel.")</p>
                                <a asp-controller="PetroCard" asp-action="Index" class="btn btn-primary btn-sm">@(isOrg ? "Manage Cards" : "My Cards")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-success bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-fuel-pump text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">Fuel Availability</h5>
                                <p class="card-text text-muted small mb-3">Real-time availability and nearby stations.</p>
                                <a asp-controller="FuelAvailability" asp-action="Index" class="btn btn-success btn-sm">View Availability</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-info bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-droplet-half text-info"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">Fuel Dispensing</h5>
                                <p class="card-text text-muted small mb-3">Start dispensing with your PetroCard or cash.</p>
                                <a asp-controller="FuelDispensing" asp-action="Index" class="btn btn-info btn-sm text-white">Start Dispensing</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@(isOrg ? "Transactions" : "My Transactions")</h5>
                        <p class="card-text text-muted small mb-3">@(isOrg ? "View fuel transactions and secured blockchain records." : "View your fuel purchase history.")</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="FuelTransaction" asp-action="Index" class="btn btn-outline-primary btn-sm">@(isOrg ? "Transactions" : "My Transactions")</a>
                            @if (isOrg)
                            {
                                <a asp-controller="BlockchainTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm">Secured Records</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@(isOrg ? "System Features" : "What you can do")</h5>
                        <ul class="list-unstyled small mb-0">
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Automated fuel dispensing</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Tamper-proof transaction records</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Real-time fuel availability</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Smart routing and directions</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="landing">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="d-flex align-items-center mb-4">
                    <img src="~/images/petro-logo.png" alt="PetroChain" class="me-3" style="height: 56px; width: auto;" />
                    <div>
                        <h1 class="landing-title mb-0">PetroChain</h1>
                        <p class="landing-subtitle text-muted mb-0">Blockchain-enabled fuel management</p>
                    </div>
                </div>
                <p class="text-body mb-4">Automated dispensing, secure transactions, and real-time fuel availability. Built for efficiency and transparency.</p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <a asp-area="Identity" asp-page="/Account/Register" class="card landing-cta-card text-decoration-none h-100">
                            <div class="card-body text-center py-4">
                                <i class="bi bi-person-plus d-block mb-2 text-primary" style="font-size: 2rem;"></i>
                                <span class="fw-semibold text-dark">Get Started</span>
                                <p class="small text-muted mb-0 mt-1">Create an account</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-sm-6">
                        <a asp-area="Identity" asp-page="/Account/Login" class="card landing-cta-card text-decoration-none h-100">
                            <div class="card-body text-center py-4">
                                <i class="bi bi-box-arrow-in-right d-block mb-2 text-secondary" style="font-size: 2rem;"></i>
                                <span class="fw-semibold text-dark">Sign In</span>
                                <p class="small text-muted mb-0 mt-1">Existing account</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <i class="bi bi-credit-card text-primary mb-2" style="font-size: 1.5rem;"></i>
                                <h6 class="fw-semibold mb-1">Smart Cards</h6>
                                <p class="small text-muted mb-0">Prepaid PetroCards for secure, automated fuel purchases.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <i class="bi bi-fuel-pump text-success mb-2" style="font-size: 1.5rem;"></i>
                                <h6 class="fw-semibold mb-1">Real-Time Availability</h6>
                                <p class="small text-muted mb-0">Check fuel and station status before you go.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <i class="bi bi-shield-check text-info mb-2" style="font-size: 1.5rem;"></i>
                                <h6 class="fw-semibold mb-1">Tamper-Proof Records</h6>
                                <p class="small text-muted mb-0">Transactions recorded securely for transparency.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <i class="bi bi-geo-alt text-warning mb-2" style="font-size: 1.5rem;"></i>
                                <h6 class="fw-semibold mb-1">Smart Routing</h6>
                                <p class="small text-muted mb-0">Directions to the nearest available station.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5 pt-4 border-top">
            <div class="col-12">
                <h2 class="h5 fw-semibold mb-3 text-center">Benefits</h2>
                <div class="row g-4 text-center">
                    <div class="col-md-4">
                        <i class="bi bi-shield-check text-primary d-block mb-2" style="font-size: 2rem;"></i>
                        <h6 class="fw-semibold">Reduced Fraud</h6>
                        <p class="small text-muted mb-0">Secure records and controlled access.</p>
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-speedometer2 text-success d-block mb-2" style="font-size: 2rem;"></i>
                        <h6 class="fw-semibold">Operational Efficiency</h6>
                        <p class="small text-muted mb-0">Automated dispensing, fewer errors.</p>
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-heart text-info d-block mb-2" style="font-size: 2rem;"></i>
                        <h6 class="fw-semibold">Better Experience</h6>
                        <p class="small text-muted mb-0">Real-time info, fewer wasted trips.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

