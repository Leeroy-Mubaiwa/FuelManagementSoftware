@{
    ViewData["Title"] = "Home";
}

@using Microsoft.AspNetCore.Identity
@using FuelManagementSoftware.Constants
@if (User.Identity?.IsAuthenticated == true)
{
    var isOrg = !User.IsInRole(AppRoles.Customer);
    var isManager = User.IsInRole(AppRoles.BranchStationManager);
    var canDispense = isManager || User.IsInRole(AppRoles.Customer);
    <div class="dashboard">
        <div class="dashboard-header mb-3">
            <h1 class="dashboard-title">Dashboard</h1>
            <p class="dashboard-subtitle text-muted mb-0">@(isOrg ? "PetroChain fuel management overview" : "Your fuel and transactions")</p>
        </div>

        <div class="dashboard-quicklinks mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small me-1">Quick access:</span>
                @if (canDispense)
                {
                <a asp-controller="FuelDispensing" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-fuel-pump me-1"></i>Dispensing</a>
                }
                <a asp-controller="FuelAvailability" asp-action="Index" class="btn btn-outline-success btn-sm"><i class="bi bi-list-ul me-1"></i>Availability</a>
                <a asp-controller="FuelAvailability" asp-action="Map" class="btn btn-outline-success btn-sm"><i class="bi bi-map me-1"></i>Map</a>
                <a asp-controller="PetroCard" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-credit-card me-1"></i>@(isOrg ? "PetroCards" : "My Cards")</a>
                <a asp-controller="FuelTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-receipt me-1"></i>@(isOrg ? "Transactions" : "My Transactions")</a>
                @if (isOrg)
                {
                    <a asp-controller="FuelStation" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-building me-1"></i>Stations</a>
                    @if (isManager)
                    {
                    <a asp-controller="FuelPump" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-droplet me-1"></i>Pumps</a>
                    }
                    <a asp-controller="BlockchainTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-shield-check me-1"></i>Secured Records</a>
                }
                <a asp-area="" asp-controller="Home" asp-action="Manual" class="btn btn-outline-secondary btn-sm"><i class="bi bi-book me-1"></i>Manual</a>
            </div>
        </div>

        @if (isOrg && ViewBag.StationsCount != null)
        {
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 bg-primary bg-opacity-10 h-100">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-building text-primary fs-4 me-2"></i>
                                <div>
                                    <div class="fw-bold fs-5">@ViewBag.StationsCount</div>
                                    <small class="text-muted">Stations</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 bg-success bg-opacity-10 h-100">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-droplet text-success fs-4 me-2"></i>
                                <div>
                                    <div class="fw-bold fs-5">@ViewBag.PumpsCount</div>
                                    <small class="text-muted">Pumps</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 bg-info bg-opacity-10 h-100">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-currency-dollar text-info fs-4 me-2"></i>
                                <div>
                                    <div class="fw-bold fs-5">@(((decimal)ViewBag.TotalSales).ToString("N0"))</div>
                                    <small class="text-muted">Total sales</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 bg-warning bg-opacity-10 h-100">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-fuel-pump text-warning fs-4 me-2"></i>
                                <div>
                                    <div class="fw-bold fs-5">@(((decimal)ViewBag.TotalFuelLitres).ToString("N0"))</div>
                                    <small class="text-muted">Litres sold</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card border-0 bg-secondary bg-opacity-10 h-100">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-receipt text-secondary fs-4 me-2"></i>
                                <div>
                                    <div class="fw-bold fs-5">@ViewBag.TransactionsCount</div>
                                    <small class="text-muted">Transactions</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            var chartLabels = ViewBag.SalesChartLabels as IList<string>;
            var hasChartData = chartLabels != null && chartLabels.Count > 0;
            <div class="row g-3 mb-4">
                <div class="col-lg-8">
                    <div class="card h-100">
                        <div class="card-header bg-transparent"><h6 class="mb-0">Sales (last 14 days)</h6></div>
                        <div class="card-body">
                            @if (hasChartData)
                            {
                                <canvas id="salesChart" height="200"></canvas>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No completed transactions in the last 14 days.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Low stock</h6>
                            <a asp-controller="FuelStock" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                        </div>
                        <div class="card-body p-0">
                            @{
                                var lowStock = ViewBag.LowStock as IEnumerable<FuelManagementSoftware.Models.FuelStock>;
                            }
                            @if (lowStock != null && lowStock.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var s in lowStock)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>@s.FuelStation?.Name – @s.FuelType?.Name</span>
                                            <span class="badge @(s.CurrentQuantity <= 0 ? "bg-danger" : "bg-warning")">@s.CurrentQuantity.ToString("F0") L</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small p-3 mb-0">No low stock alerts.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            var recentTx = ViewBag.RecentTransactions as IEnumerable<FuelManagementSoftware.Models.FuelTransaction>;
            if (recentTx != null && recentTx.Any())
            {
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Recent transactions</h6>
                                <a asp-controller="FuelTransaction" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Transaction</th>
                                                <th>Date</th>
                                                <th>Station</th>
                                                <th>Fuel</th>
                                                <th>Quantity</th>
                                                <th>Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var t in recentTx)
                                            {
                                                <tr>
                                                    <td><code>@t.TransactionNumber</code></td>
                                                    <td><small>@(t.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small></td>
                                                    <td><small>@t.FuelStation?.Name</small></td>
                                                    <td><small>@t.FuelType?.Name</small></td>
                                                    <td>@t.Quantity.ToString("F0") L</td>
                                                    <td>@t.TotalAmount.ToString("F2") @t.Currency</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-primary bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-credit-card text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">@(isOrg ? "PetroCards" : "My Cards")</h5>
                                <p class="card-text text-muted small mb-3">@(isOrg ? "Manage prepaid smart cards for fuel dispensing." : "View and use your PetroCards for fuel.")</p>
                                <a asp-controller="PetroCard" asp-action="Index" class="btn btn-primary btn-sm">@(isOrg ? "Manage Cards" : "My Cards")</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-success bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-fuel-pump text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">Fuel Availability</h5>
                                <p class="card-text text-muted small mb-3">Real-time availability and nearby stations.</p>
                                <a asp-controller="FuelAvailability" asp-action="Index" class="btn btn-success btn-sm">View Availability</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        @if (canDispense)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-3">
                            <div class="dashboard-card-icon bg-info bg-opacity-10 rounded-2 p-2 me-3">
                                <i class="bi bi-droplet-half text-info"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">Fuel Dispensing</h5>
                                <p class="card-text text-muted small mb-3">Start dispensing with your PetroCard.</p>
                                <a asp-controller="FuelDispensing" asp-action="Index" class="btn btn-info btn-sm text-white">Start Dispensing</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@(isOrg ? "Transactions" : "My Transactions")</h5>
                        <p class="card-text text-muted small mb-3">@(isOrg ? "View fuel transactions and secured blockchain records." : "View your fuel purchase history.")</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="FuelTransaction" asp-action="Index" class="btn btn-outline-primary btn-sm">@(isOrg ? "Transactions" : "My Transactions")</a>
                            @if (isOrg)
                            {
                                <a asp-controller="BlockchainTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm">Secured Records</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card dashboard-card">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@(isOrg ? "System Features" : "What you can do")</h5>
                        <ul class="list-unstyled small mb-0">
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Automated fuel dispensing</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Tamper-proof transaction records</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Real-time fuel availability</li>
                            <li class="d-flex align-items-center py-1"><i class="bi bi-check2 text-success me-2"></i>Smart routing and directions</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="landing py-3">
        <div class="text-center mb-3">
            <img src="~/images/petro-logo.png" alt="PetroChain" class="mb-2" style="height: 50px; width: auto;" />
            <h1 class="h2 fw-bold mb-1">PetroChain™</h1>
            <p class="small text-muted mb-0">Blockchain-Powered Fuel Management</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body p-3">
                        <h2 class="h5 mb-3 text-center">System Access Guide</h2>
                        
                        <div class="row g-3">
                            <!-- Petrotrade Admin -->
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100 bg-light d-flex flex-column">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            <i class="bi bi-shield-lock small"></i>
                                        </div>
                                        <h3 class="h6 mb-0 fw-bold">Admin</h3>
                                    </div>
                                    <div class="flex-grow-1">
                                        <ul class="list-unstyled mb-2" style="font-size: 0.75rem; display: grid; grid-template-columns: 1fr; gap: 2px;">
                                            <li><i class="bi bi-check2 text-primary me-1"></i>Register all stations</li>
                                            <li><i class="bi bi-check2 text-primary me-1"></i>View fuel availability</li>
                                            <li><i class="bi bi-check2 text-primary me-1"></i>Audit transactions</li>
                                            <li><i class="bi bi-check2 text-primary me-1"></i>Set fuel prices</li>
                                            <li><i class="bi bi-check2 text-primary me-1"></i>View sales & stock updates</li>
                                        </ul>
                                    </div>
                                    <div class="mt-2 mb-2 p-1 px-2 bg-white border rounded text-center" style="font-size: 0.7rem;">
                                        <code class="d-block">admin@petrotrade.co.zw</code>
                                        <code class="text-muted">Pass: Admin@123</code>
                                    </div>
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-sm w-100">Login as Admin</a>
                                </div>
                            </div>

                            <!-- Branch Manager -->
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100 bg-light d-flex flex-column">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            <i class="bi bi-gear small"></i>
                                        </div>
                                        <h3 class="h6 mb-0 fw-bold">Manager</h3>
                                    </div>
                                    <div class="flex-grow-1">
                                        <ul class="list-unstyled mb-2" style="font-size: 0.75rem; display: grid; grid-template-columns: 1fr; gap: 2px;">
                                            <li><i class="bi bi-check2 text-success me-1"></i>Activate fuel pumps</li>
                                            <li><i class="bi bi-check2 text-success me-1"></i>Update stock levels</li>
                                            <li><i class="bi bi-check2 text-success me-1"></i>Dispense fuel</li>
                                            <li><i class="bi bi-check2 text-success me-1"></i>Sales & stock reports</li>
                                        </ul>
                                    </div>
                                    <div class="mt-2 mb-2 p-1 px-2 bg-white border rounded text-center" style="font-size: 0.7rem;">
                                        <code class="d-block">manager@petrotrade.co.zw</code>
                                        <code class="text-muted">Pass: Manager@123</code>
                                    </div>
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success btn-sm w-100">Login as Manager</a>
                                </div>
                            </div>

                            <!-- Customer -->
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100 bg-light d-flex flex-column">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            <i class="bi bi-person small"></i>
                                        </div>
                                        <h3 class="h6 mb-0 fw-bold">Customer</h3>
                                    </div>
                                    <div class="flex-grow-1">
                                        <ul class="list-unstyled mb-2" style="font-size: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 2px;">
                                            <li><i class="bi bi-check2 text-info me-1"></i>Register</li>
                                            <li><i class="bi bi-check2 text-info me-1"></i>Fuel Prices</li>
                                            <li><i class="bi bi-check2 text-info me-1"></i>Availability</li>
                                            <li><i class="bi bi-check2 text-info me-1"></i>Nearby Stations</li>
                                            <li><i class="bi bi-check2 text-info me-1"></i>TopUp NFC</li>
                                            <li><i class="bi bi-check2 text-info me-1"></i>History</li>
                                        </ul>
                                    </div>
                                    <div class="mt-2 mb-2 p-1 px-2 bg-white border rounded text-center" style="font-size: 0.7rem;">
                                        <code class="d-block">customer@gmail.com</code>
                                        <code class="text-muted">Pass: Customer@123</code>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-info btn-sm text-white flex-grow-1">Login</a>
                                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-info btn-sm flex-grow-1">Register</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row text-center g-3">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-link-45deg text-primary me-2"></i>
                            <span class="small fw-bold">Blockchain Secured</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-geo-alt text-success me-2"></i>
                            <span class="small fw-bold">Real-Time Mapping</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-nfc text-info me-2"></i>
                            <span class="small fw-bold">NFC Automation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (User.Identity?.IsAuthenticated == true && ViewBag.SalesChartLabels != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesChartLabels));
                var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesChartData));
                var el = document.getElementById('salesChart');
                if (el && labels && labels.length > 0) {
                    new Chart(el, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Sales',
                                data: data,
                                backgroundColor: 'rgba(29, 78, 216, 0.5)',
                                borderColor: 'rgb(29, 78, 216)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                }
            })();
        </script>
    }
}

