<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FuelManagementSoftware</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FuelManagementSoftware.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FuelManagementSoftware</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="FuelDispensing" asp-action="Index">Fuel Dispensing</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="availabilityDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Fuel Availability
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="availabilityDropdown">
                                    <li><a class="dropdown-item" asp-controller="FuelAvailability" asp-action="Index">List View</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelAvailability" asp-action="Map">Map & Directions</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="managementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Management
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="managementDropdown">
                                    <li><a class="dropdown-item" asp-controller="FuelStation" asp-action="Index">Stations</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelPump" asp-action="Index">Pumps</a></li>
                                    <li><a class="dropdown-item" asp-controller="PetroCard" asp-action="Index">PetroCards</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelStock" asp-action="Index">Fuel Stock</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelType" asp-action="Index">Fuel Types</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="FuelTransaction" asp-action="Index">Transactions</a></li>
                                    <li><a class="dropdown-item" asp-controller="BlockchainTransaction" asp-action="Index">Blockchain Transactions</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Reports
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="reportsDropdown">
                                    <li><a class="dropdown-item" asp-controller="FuelTransaction" asp-action="Index">Sales Reports</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelStock" asp-action="Index">Stock Reports</a></li>
                                    <li><a class="dropdown-item" asp-controller="FuelTransaction" asp-action="Index">Transaction History</a></li>
                                    <li><a class="dropdown-item" asp-controller="BlockchainTransaction" asp-action="Index">Blockchain Records</a></li>
                                </ul>
                            </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("SystemAdmin") || User.IsInRole("OrganizationAdmin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administration
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" href="#">Organizations</a></li>
                                        <li><a class="dropdown-item" href="#">Users</a></li>
                                        <li><a class="dropdown-item" href="#">Roles</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#">System Configuration</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top  text-muted">
        <div class="container">
            &copy; 2026 - FuelManagementSoftware - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
