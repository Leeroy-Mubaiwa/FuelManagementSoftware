@model FuelManagementSoftware.Controllers.StockMovementViewModel
@{
    ViewData["Title"] = "Add Stock";
}

<h5 class="mb-3">Add Stock - @Model.StationName</h5>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Fuel Type:</dt>
                    <dd class="col-sm-8">@Model.FuelTypeName</dd>
                    <dt class="col-sm-4">Current Stock:</dt>
                    <dd class="col-sm-8"><strong>@Model.CurrentQuantity.ToString("F2") @Model.Unit</strong></dd>
                </dl>
            </div>
        </div>
        
        <form asp-action="AddStock">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="FuelStockId" />
            <input type="hidden" asp-for="FuelStationId" />
            <input type="hidden" asp-for="FuelTypeId" />
            
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control form-control-sm" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ReferenceNumber" class="form-label"></label>
                <input asp-for="ReferenceNumber" class="form-control form-control-sm" />
                <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="DeliveryNoteNumber" class="form-label"></label>
                <input asp-for="DeliveryNoteNumber" class="form-control form-control-sm" />
                <span asp-validation-for="DeliveryNoteNumber" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TankerRegistration" class="form-label"></label>
                    <input asp-for="TankerRegistration" class="form-control form-control-sm" />
                    <span asp-validation-for="TankerRegistration" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DriverName" class="form-label"></label>
                    <input asp-for="DriverName" class="form-control form-control-sm" />
                    <span asp-validation-for="DriverName" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control form-control-sm" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-sm btn-primary">Add Stock</button>
                <a asp-action="Details" asp-route-id="@Model.FuelStockId" class="btn btn-sm btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

