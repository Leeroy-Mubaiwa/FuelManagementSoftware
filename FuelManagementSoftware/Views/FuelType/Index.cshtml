@model IEnumerable<FuelManagementSoftware.Models.FuelType>
@{
    ViewData["Title"] = "Fuel Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Fuel Types</h4>
    <a asp-action="Create" class="btn btn-sm btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Unit Price</th>
                <th>Unit</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><small class="text-muted">@(item.Code ?? "-")</small></td>
                    <td>@item.UnitPrice.ToString("F2")</td>
                    <td><small>@item.Unit</small></td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

