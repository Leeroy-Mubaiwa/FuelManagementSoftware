@{
    ViewData["Title"] = "Start Fuel Dispensing";
    var pump = ViewBag.Pump as FuelManagementSoftware.Models.FuelPump;
}

<div class="container mt-4">
    <h2>Start Fuel Dispensing - Pump @pump?.PumpNumber</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Pump Information</h5>
                    <p><strong>Fuel Type:</strong> @pump?.FuelType?.Name</p>
                    <p><strong>Station:</strong> @pump?.FuelStation?.Name</p>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Instructions</h5>
                    <p id="instructionsText">Choose payment method, then follow the steps.</p>
                </div>
            </div>
            
            <form id="dispensingForm" asp-action="Initiate" method="post">
                <input type="hidden" name="FuelStationId" value="@pump?.FuelStationId" />
                <input type="hidden" name="FuelPumpId" value="@pump?.Id" />
                <input type="hidden" name="FuelTypeId" value="@pump?.FuelTypeId" />
                <input type="hidden" name="PaymentMethod" id="PaymentMethod" value="PetroCard" />

                <div class="form-group mb-3">
                    <label class="form-label">Payment method</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethodRadio" id="payPetroCard" value="PetroCard" checked>
                            <label class="form-check-label" for="payPetroCard"><i class="bi bi-credit-card me-1"></i>PetroCard</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethodRadio" id="payCash" value="Cash">
                            <label class="form-check-label" for="payCash"><i class="bi bi-cash me-1"></i>Cash</label>
                        </div>
                    </div>
                </div>

                <div id="cardPaymentSection">
                    <div id="nfcStatus" class="alert alert-info small mb-3">Checking card reader...</div>
                    <div class="form-group mb-3">
                        <label for="NfcTag" class="form-label">Card ID</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="NfcTag" name="NfcTag" readonly />
                            <button type="button" class="btn btn-outline-secondary" id="readNfcBtn" onclick="readNfcTag()">
                                <i class="bi bi-wifi me-1"></i><span id="readNfcBtnText">Tap Card</span>
                            </button>
                        </div>
                        <small class="form-text text-muted">Tap your PetroCard, or use the button to read</small>
                    </div>
                    <div class="form-group mb-3" id="cardInfo" style="display: none;">
                        <div class="alert alert-info">
                            <strong>Card:</strong> <span id="cardNumber"></span><br>
                            <strong>Balance:</strong> <span id="cardBalance"></span> <span id="cardCurrency"></span>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label for="Pin" class="form-label">PIN (if required)</label>
                        <input type="password" class="form-control" id="Pin" name="Pin" maxlength="6" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="RequestedQuantity" class="form-label">Requested quantity (litres) — leave empty for fill-up</label>
                    <input type="number" class="form-control" id="RequestedQuantity" name="RequestedQuantity" step="0.01" min="0" />
                </div>
                
                <button type="submit" class="btn btn-primary" id="startBtn">Start Dispensing</button>
                <a href="@Url.Action("SelectPump", new { stationId = pump?.FuelStationId })" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pumpId = @pump?.Id;
        let requiresPin = false;
        let nfcSupported = ('NDEFReader' in window);

        function isCash() {
            return document.getElementById('payCash').checked;
        }

        function updatePaymentUI() {
            const cash = isCash();
            const cardSection = document.getElementById('cardPaymentSection');
            const startBtn = document.getElementById('startBtn');
            const instructionsText = document.getElementById('instructionsText');
            const nfcInput = document.getElementById('NfcTag');

            document.getElementById('PaymentMethod').value = cash ? 'Cash' : 'PetroCard';
            cardSection.style.display = cash ? 'none' : 'block';

            if (cash) {
                nfcInput.removeAttribute('required');
                nfcInput.value = '';
                startBtn.disabled = false;
                instructionsText.innerHTML = '<strong>Cash:</strong> Select quantity (or leave empty for fill-up), then click Start Dispensing. Customer pays cash at the end.';
            } else {
                nfcInput.setAttribute('required', 'required');
                instructionsText.innerHTML = '<strong>PetroCard:</strong> Tap your card, enter PIN if required, set quantity (or leave empty for fill-up), then click Start Dispensing.';
                startBtn.disabled = !nfcInput.value.trim() || (requiresPin && document.getElementById('Pin').value.length < 4);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('payPetroCard').addEventListener('change', updatePaymentUI);
            document.getElementById('payCash').addEventListener('change', updatePaymentUI);

            const nfcStatus = document.getElementById('nfcStatus');
            if (nfcSupported) {
                nfcStatus.innerHTML = '<i class="bi bi-wifi me-1"></i>Card reader ready — tap your PetroCard on this device';
                nfcStatus.className = 'alert alert-success small';
            } else {
                nfcStatus.innerHTML = '<i class="bi bi-wifi-off me-1"></i>Contactless reading not available. You can type your card ID manually.';
                nfcStatus.className = 'alert alert-warning small';
                document.getElementById('NfcTag').removeAttribute('readonly');
            }
            updatePaymentUI();
        });

        async function readNfcTag() {
            const btn = document.getElementById('readNfcBtn');
            const btnText = document.getElementById('readNfcBtnText');
            const nfcTagInput = document.getElementById('NfcTag');

            if (nfcSupported) {
                // Use real Web NFC API
                btn.disabled = true;
                btnText.textContent = 'Waiting for tap...';
                try {
                    const ndef = new NDEFReader();
                    await ndef.scan();
                    ndef.addEventListener('reading', ({ serialNumber }) => {
                        const uid = serialNumber.replace(/:/g, '').toUpperCase();
                        nfcTagInput.value = uid;
                        btnText.textContent = 'Tap Card';
                        btn.disabled = false;
                        lookupCard(uid);
                    }, { once: true });
                } catch (error) {
                    console.error('Card read error:', error);
                    btnText.textContent = 'Tap Card';
                    btn.disabled = false;
                    alert('Could not read your card. Please try again.');
                }
            } else {
                // Fallback: use server-side NFC reader or manual entry
                btn.disabled = true;
                btnText.textContent = 'Reading...';
                try {
                    const response = await fetch(`/FuelDispensing/ReadNfcTag?pumpId=${pumpId}`);
                    const data = await response.json();
                    if (data.success) {
                        nfcTagInput.value = data.nfcTag;
                        showCardInfo(data);
                    } else {
                        // Allow manual entry
                        nfcTagInput.removeAttribute('readonly');
                        nfcTagInput.focus();
                        alert(data.message || 'No card detected. You can type your card ID manually.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    nfcTagInput.removeAttribute('readonly');
                    alert('Could not read card. You can type your card ID manually.');
                } finally {
                    btn.disabled = false;
                    btnText.textContent = 'Tap Card';
                }
            }
        }

        async function lookupCard(nfcTag) {
            try {
                const response = await fetch(`/FuelDispensing/LookupCard?nfcTag=${encodeURIComponent(nfcTag)}`);
                const data = await response.json();
                if (data.success) {
                    showCardInfo(data);
                } else {
                    alert(data.message || 'Card not recognised. Please check and try again.');
                }
            } catch (error) {
                console.error('Card lookup error:', error);
            }
        }

        function showCardInfo(data) {
            if (isCash()) return;
            document.getElementById('cardNumber').textContent = data.cardNumber;
            document.getElementById('cardBalance').textContent = data.balance.toFixed(2);
            document.getElementById('cardCurrency').textContent = data.currency;
            document.getElementById('cardInfo').style.display = 'block';
            requiresPin = data.requiresPin;
            const startBtn = document.getElementById('startBtn');
            if (!requiresPin) {
                startBtn.disabled = false;
            } else {
                const pinInput = document.getElementById('Pin');
                pinInput.required = true;
                pinInput.addEventListener('input', function () {
                    startBtn.disabled = pinInput.value.length < 4;
                });
            }
        }
    </script>
}

