@model IEnumerable<FuelManagementSoftware.Models.FuelStation>
@{
    ViewData["Title"] = "Fuel Availability";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Fuel Availability & Routing</h4>
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label small">Fuel Type</label>
                <select name="fuelTypeId" asp-items="ViewBag.FuelTypes" class="form-select form-select-sm">
                    <option value="">All Fuel Types</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Your Latitude</label>
                <input name="latitude" type="number" step="0.00000001" value="@ViewBag.Latitude" class="form-control form-control-sm" placeholder="e.g., -17.8292" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Your Longitude</label>
                <input name="longitude" type="number" step="0.00000001" value="@ViewBag.Longitude" class="form-control form-control-sm" placeholder="e.g., 31.0522" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary me-2">Search</button>
                <a asp-action="Map" class="btn btn-sm btn-success">Map & Directions</a>
            </div>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var station in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card @(station.IsTankerOffloading ? "border-warning" : !station.IsOpen ? "border-danger" : "border-success")">
                <div class="card-header @(station.IsTankerOffloading ? "bg-warning" : !station.IsOpen ? "bg-danger text-white" : "bg-success text-white")">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">@station.Name</h6>
                        @if (station.IsTankerOffloading)
                        {
                            <span class="badge bg-dark">Tanker Offloading</span>
                        }
                        else if (!station.IsOpen)
                        {
                            <span class="badge bg-dark">Closed</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">Open</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><small><strong>Address:</strong> @station.Address</small></p>
                    @if (station.Phone != null)
                    {
                        <p class="mb-2"><small><strong>Phone:</strong> @station.Phone</small></p>
                    }
                    
                    <div class="mt-2">
                        <strong class="small">Available Fuel:</strong>
                        <div class="mt-1">
                            @if (station.FuelStocks.Any())
                            {
                                @foreach (var stock in station.FuelStocks.Where(s => s.CurrentQuantity > 0).OrderBy(s => s.FuelType.Name))
                                {
                                    var percentage = stock.Capacity > 0 ? (stock.CurrentQuantity / stock.Capacity * 100) : 0;
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small><strong>@stock.FuelType?.Name</strong></small>
                                            <small>@stock.CurrentQuantity.ToString("F0") / @stock.Capacity.ToString("F0") @stock.Unit</small>
                                        </div>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(percentage < 20 ? "bg-danger" : percentage < 50 ? "bg-warning" : "bg-success")" 
                                                 role="progressbar" style="width: @percentage%">
                                                @percentage.ToString("F0")%
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0"><small>No stock information available</small></p>
                            }
                        </div>
                    </div>
                    
                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <small><strong>Operational Pumps:</strong> @station.FuelPumps.Count(p => p.IsActive && p.IsOperational)</small>
                            <div>
                                @if (station.Latitude.HasValue && station.Longitude.HasValue)
                                {
                                    <a asp-action="Map" asp-route-stationId="@station.Id" class="btn btn-sm btn-success me-1">Get Directions</a>
                                }
                                <a asp-action="StationDetails" asp-route-id="@station.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p class="mb-0">No stations found matching your criteria.</p>
    </div>
}

