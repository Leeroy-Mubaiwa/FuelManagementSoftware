@model FuelManagementSoftware.Models.FuelStation
@{
    ViewData["Title"] = "Station Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@Model.Name</h4>
    <a asp-action="Index" class="btn btn-sm btn-secondary">Back to Availability</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">Station Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">City:</dt>
                    <dd class="col-sm-8">@(Model.City ?? "-")</dd>
                    <dt class="col-sm-4">Phone:</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsTankerOffloading)
                        {
                            <span class="badge bg-warning">Tanker Offloading - Closed</span>
                        }
                        else if (!Model.IsOpen)
                        {
                            <span class="badge bg-danger">Closed</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Open</span>
                        }
                    </dd>
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <dt class="col-sm-4">Location:</dt>
                        <dd class="col-sm-8"><small class="text-muted">@Model.Latitude, @Model.Longitude</small></dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">Fuel Stock Availability</h6>
            </div>
            <div class="card-body">
                @if (Model.FuelStocks.Any())
                {
                    @foreach (var stock in Model.FuelStocks.OrderBy(s => s.FuelType.Name))
                    {
                        var percentage = stock.Capacity > 0 ? (stock.CurrentQuantity / stock.Capacity * 100) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <strong>@stock.FuelType?.Name</strong>
                                <span>@stock.CurrentQuantity.ToString("F2") / @stock.Capacity.ToString("F2") @stock.Unit</span>
                            </div>
                            <div class="progress" style="height: 25px;">
                                <div class="progress-bar @(percentage < 20 ? "bg-danger" : percentage < 50 ? "bg-warning" : "bg-success")" 
                                     role="progressbar" style="width: @percentage%">
                                    @percentage.ToString("F1")%
                                </div>
                            </div>
                            @if (stock.IsLowStock)
                            {
                                <small class="text-warning">⚠ Low stock warning</small>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0"><small>No stock information</small></p>
                }
            </div>
        </div>
        
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Operational Pumps</h6>
            </div>
            <div class="card-body">
                @if (Model.FuelPumps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th>Pump</th>
                                    <th>Fuel Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pump in Model.FuelPumps.OrderBy(p => p.PumpNumber))
                                {
                                    <tr>
                                        <td>@pump.PumpNumber</td>
                                        <td><small>@pump.FuelType?.Name</small></td>
                                        <td>
                                            @if (pump.IsOperational && pump.IsActive)
                                            {
                                                <span class="badge bg-success">Available</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Available</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0"><small>No pumps configured</small></p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.QueueInformations.Any())
{
    <div class="card mt-3">
        <div class="card-header bg-light">
            <h6 class="mb-0">Recent Queue Information</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-borderless mb-0">
                    <thead>
                        <tr>
                            <th>Recorded</th>
                            <th>Queue Length</th>
                            <th>Wait Time</th>
                            <th>Active Pumps</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var queue in Model.QueueInformations)
                        {
                            <tr>
                                <td><small>@queue.RecordedAt.ToString("MM/dd/yyyy HH:mm")</small></td>
                                <td>@queue.EstimatedQueueLength vehicles</td>
                                <td>@(queue.EstimatedWaitTimeMinutes?.ToString() ?? "-") minutes</td>
                                <td>@queue.ActivePumps</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

