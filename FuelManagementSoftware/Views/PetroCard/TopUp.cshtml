@model FuelManagementSoftware.Controllers.TopUpViewModel
@{
    ViewData["Title"] = "Top Up PetroCard";
}

<h5 class="mb-3">Top Up PetroCard</h5>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Card Number:</dt>
                    <dd class="col-sm-8">@Model.CardNumber</dd>
                    <dt class="col-sm-4">Current Balance:</dt>
                    <dd class="col-sm-8"><strong>@Model.CurrentBalance.ToString("F2") @Model.Currency</strong></dd>
                </dl>
            </div>
        </div>
        
        <form asp-action="TopUp">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="CardId" />
            
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control form-control-sm" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <select asp-for="PaymentMethod" class="form-select form-select-sm">
                    <option value="">-- Select --</option>
                    <option value="Cash">Cash</option>
                    <option value="BankTransfer">Bank Transfer</option>
                    <option value="MobileMoney">Mobile Money</option>
                    <option value="Card">Card</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ReferenceNumber" class="form-label"></label>
                <input asp-for="ReferenceNumber" class="form-control form-control-sm" />
                <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-sm btn-primary">Top Up</button>
                <a asp-action="Details" asp-route-id="@Model.CardId" class="btn btn-sm btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

