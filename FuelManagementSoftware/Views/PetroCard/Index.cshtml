@model IEnumerable<FuelManagementSoftware.Models.PetroCard>
@{
    ViewData["Title"] = "PetroCards";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">PetroCards</h4>
    <a asp-action="Create" class="btn btn-sm btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>Card Number</th>
                <th>NFC Tag</th>
                <th>User</th>
                <th>Balance</th>
                <th>Status</th>
                <th>Last Used</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CardNumber</td>
                    <td><small class="text-muted">@(item.Rfidtag ?? "-")</small></td>
                    <td>@item.User?.UserName</td>
                    <td>@item.Balance.ToString("F2") @item.Currency</td>
                    <td>
                        @if (item.IsBlocked)
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                        else if (!item.IsActive)
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        else if (item.ExpiryDate.HasValue && item.ExpiryDate.Value < DateTime.UtcNow)
                        {
                            <span class="badge bg-warning">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td><small class="text-muted">@(item.LastUsedAt?.ToString("MM/dd/yyyy") ?? "-")</small></td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                            <a asp-action="TopUp" asp-route-id="@item.Id" class="btn btn-outline-success">Top Up</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

