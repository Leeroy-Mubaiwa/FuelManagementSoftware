@model FuelManagementSoftware.Controllers.PetroCardViewModel
@{
    ViewData["Title"] = "Edit PetroCard";
}

<h5 class="mb-3">Edit PetroCard</h5>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="CardNumber" class="form-label"></label>
                <input asp-for="CardNumber" class="form-control form-control-sm" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Rfidtag" class="form-label"></label>
                <input asp-for="Rfidtag" class="form-control form-control-sm" />
                <span asp-validation-for="Rfidtag" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <select asp-for="UserId" asp-items="ViewBag.UserId" class="form-select form-select-sm">
                    <option value="">-- Select User --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Balance" class="form-label"></label>
                <input asp-for="Balance" class="form-control form-control-sm" type="number" step="0.01" />
                <span asp-validation-for="Balance" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Currency" class="form-label"></label>
                <select asp-for="Currency" class="form-select form-select-sm">
                    <option value="USD">USD</option>
                    <option value="ZWL">ZWL</option>
                </select>
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Pin" class="form-label"></label>
                <input asp-for="Pin" class="form-control form-control-sm" type="password" maxlength="6" />
                <span asp-validation-for="Pin" class="text-danger"></span>
                <small class="form-text text-muted">Leave blank to keep current PIN</small>
            </div>
            
            <div class="mb-3">
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" class="form-control form-control-sm" type="date" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>
            
            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            
            <div class="mb-3 form-check">
                <input asp-for="IsBlocked" class="form-check-input" type="checkbox" />
                <label asp-for="IsBlocked" class="form-check-label"></label>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-sm btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

