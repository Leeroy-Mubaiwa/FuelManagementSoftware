@model FuelManagementSoftware.Models.BlockchainTransaction
@{
    ViewData["Title"] = "Blockchain Transaction Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Blockchain Transaction</h4>
    <a asp-action="Index" class="btn btn-sm btn-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">Blockchain Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Hash:</dt>
                    <dd class="col-sm-8"><code class="small">@Model.BlockchainHash</code></dd>
                    <dt class="col-sm-4">Previous Hash:</dt>
                    <dd class="col-sm-8"><code class="small">@(Model.PreviousHash ?? "-")</code></dd>
                    <dt class="col-sm-4">Block Number:</dt>
                    <dd class="col-sm-8">@(Model.BlockNumber?.ToString() ?? "-")</dd>
                    <dt class="col-sm-4">Transaction Index:</dt>
                    <dd class="col-sm-8">@(Model.TransactionIndex?.ToString() ?? "-")</dd>
                    <dt class="col-sm-4">Network:</dt>
                    <dd class="col-sm-8">@(Model.BlockchainNetwork ?? "-")</dd>
                    <dt class="col-sm-4">Contract Address:</dt>
                    <dd class="col-sm-8"><code class="small">@(Model.SmartContractAddress ?? "-")</code></dd>
                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Status == "Confirmed" ? "bg-success" : Model.Status == "Failed" ? "bg-danger" : "bg-warning")">
                            @Model.Status
                        </span>
                    </dd>
                    <dt class="col-sm-4">Confirmations:</dt>
                    <dd class="col-sm-8">@Model.ConfirmationCount</dd>
                    <dt class="col-sm-4">Created:</dt>
                    <dd class="col-sm-8"><small class="text-muted">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm:ss")</small></dd>
                    <dt class="col-sm-4">Confirmed:</dt>
                    <dd class="col-sm-8"><small class="text-muted">@(Model.ConfirmedAt?.ToString("MM/dd/yyyy HH:mm:ss") ?? "-")</small></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0">Related Fuel Transaction</h6>
            </div>
            <div class="card-body">
                @if (Model.FuelTransaction != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Transaction #:</dt>
                        <dd class="col-sm-8"><code>@Model.FuelTransaction.TransactionNumber</code></dd>
                        <dt class="col-sm-4">Station:</dt>
                        <dd class="col-sm-8">@Model.FuelTransaction.FuelStation?.Name</dd>
                        <dt class="col-sm-4">Pump:</dt>
                        <dd class="col-sm-8">@Model.FuelTransaction.FuelPump?.PumpNumber</dd>
                        <dt class="col-sm-4">Fuel Type:</dt>
                        <dd class="col-sm-8">@Model.FuelTransaction.FuelType?.Name</dd>
                        <dt class="col-sm-4">Quantity:</dt>
                        <dd class="col-sm-8">@Model.FuelTransaction.Quantity.ToString("F2")L</dd>
                        <dt class="col-sm-4">Amount:</dt>
                        <dd class="col-sm-8"><strong>@Model.FuelTransaction.TotalAmount.ToString("F2") @Model.FuelTransaction.Currency</strong></dd>
                        <dt class="col-sm-4">Date:</dt>
                        <dd class="col-sm-8"><small>@Model.FuelTransaction.TransactionDate.ToString("MM/dd/yyyy HH:mm")</small></dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-controller="FuelTransaction" asp-action="Details" asp-route-id="@Model.FuelTransaction.Id" class="btn btn-sm btn-outline-primary">View Full Transaction</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

