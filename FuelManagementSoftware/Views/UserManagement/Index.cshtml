@using FuelManagementSoftware.Areas.Identity.Data
@model IEnumerable<FuelManagementSoftwareUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
    var stations = ViewBag.Stations as Dictionary<int, string>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">User Management</h4>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Assigned Station</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><span class="fw-medium">@user.UserName</span></td>
                    <td><small>@user.Email</small></td>
                    <td>
                        @if (userRoles != null && userRoles.ContainsKey(user.Id))
                        {
                            foreach (var role in userRoles[user.Id])
                            {
                                <span class="badge bg-info text-dark me-1">@role</span>
                            }
                        }
                    </td>
                    <td>
                        @if (user.ManagedStationId.HasValue && stations != null && stations.ContainsKey(user.ManagedStationId.Value))
                        {
                            <span class="text-success"><i class="bi bi-building me-1"></i>@stations[user.ManagedStationId.Value]</span>
                        }
                        else
                        {
                            <span class="text-muted small">None (Global)</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit / Assign</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
