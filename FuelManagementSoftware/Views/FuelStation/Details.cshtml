@model FuelManagementSoftware.Models.FuelStation
@using FuelManagementSoftware.Constants
@{
    ViewData["Title"] = "Station Details";
    ViewBag.StationId = Model.Id;
    ViewBag.StationName = Model.Name;
    var isManager = User.IsInRole(AppRoles.BranchStationManager);
    var canDispense = isManager;
}
@await Html.PartialAsync("_StationContext")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@Model.Name</h4>
    <div>
        @if (User.IsInRole(AppRoles.PetrotradeAdmin))
        {
        <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm @(Model.IsOpen ? "btn-warning" : "btn-success")">
                @(Model.IsOpen ? "Close" : "Open") Station
            </button>
        </form>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Edit</a>
        }
        <a asp-action="Index" class="btn btn-sm btn-secondary">Back to List</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 bg-light">
            <div class="card-body py-2">
                <span class="small text-muted me-2">Quick actions:</span>
                @if (isManager)
                {
                <a asp-controller="FuelPump" asp-action="Index" asp-route-stationId="@Model.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-droplet me-1"></i>All Pumps</a>
                }
                <a asp-controller="FuelStock" asp-action="Index" asp-route-stationId="@Model.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-box-seam me-1"></i>Stock</a>
                @if (isManager)
                {
                <a asp-controller="FuelStock" asp-action="Create" asp-route-stationId="@Model.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-plus me-1"></i>Add Stock</a>
                }
                <a asp-controller="FuelTransaction" asp-action="Index" asp-route-stationId="@Model.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-receipt me-1"></i>Transactions</a>
                @if (canDispense)
                {
                <a asp-controller="FuelDispensing" asp-action="SelectPump" asp-route-stationId="@Model.Id" class="btn btn-sm btn-success"><i class="bi bi-fuel-pump me-1"></i>Start Dispensing</a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0">Station Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">Code:</dt>
                    <dd class="col-sm-8">@(Model.Code ?? "-")</dd>
                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">City:</dt>
                    <dd class="col-sm-8">@(Model.City ?? "-")</dd>
                    <dt class="col-sm-4">Phone:</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (!Model.IsOpen)
                        {
                            <span class="badge bg-danger">Closed</span>
                        }
                        else if (Model.IsTankerOffloading)
                        {
                            <span class="badge bg-warning">Tanker Offloading</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Open</span>
                        }
                    </dd>
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <dt class="col-sm-4">Location:</dt>
                        <dd class="col-sm-8"><small class="text-muted">@Model.Latitude, @Model.Longitude</small></dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Fuel Pumps (@Model.FuelPumps.Count)</h6>
                @if (isManager)
                {
                    <div class="btn-group btn-group-sm">
                        <a asp-controller="FuelPump" asp-action="Create" asp-route-stationId="@Model.Id" class="btn btn-outline-primary">Create</a>
                        <a asp-controller="FuelPump" asp-action="Index" asp-route-stationId="@Model.Id" class="btn btn-outline-primary">View all</a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model.FuelPumps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th>Pump</th>
                                    <th>Fuel Type</th>
                                    <th>Status</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pump in Model.FuelPumps.OrderBy(p => p.PumpNumber))
                                {
                                    <tr>
                                        <td>@pump.PumpNumber</td>
                                        <td><small>@pump.FuelType?.Name</small></td>
                                        <td>
                                            @if (pump.IsOperational && pump.IsActive)
                                            {
                                                <span class="badge bg-success">Operational</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Available</span>
                                            }
                                        </td>
                                        <td class="text-end"><a asp-controller="FuelPump" asp-action="Details" asp-route-id="@pump.Id" class="btn btn-sm btn-link py-0">Details</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0"><small>No pumps configured.</small></p>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Fuel Stock</h6>
                <a asp-controller="FuelStock" asp-action="Index" asp-route-stationId="@Model.Id" class="btn btn-sm btn-outline-primary">View all</a>
            </div>
            <div class="card-body">
                @if (Model.FuelStocks.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th>Fuel Type</th>
                                    <th>Quantity</th>
                                    <th>Status</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in Model.FuelStocks.OrderBy(s => s.FuelType.Name))
                                {
                                    <tr>
                                        <td><small>@stock.FuelType?.Name</small></td>
                                        <td>@stock.CurrentQuantity.ToString("F2") / @stock.Capacity.ToString("F2") @stock.Unit</td>
                                        <td>
                                            @if (stock.IsLowStock)
                                            {
                                                <span class="badge bg-warning">Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Available</span>
                                            }
                                        </td>
                                        <td class="text-end"><a asp-controller="FuelStock" asp-action="Details" asp-route-id="@stock.Id" class="btn btn-sm btn-link py-0">Details</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0"><small>No stock information.</small>
                    @if (isManager)
                    {
                    <a asp-controller="FuelStock" asp-action="Create" asp-route-stationId="@Model.Id">Add stock</a>
                    }
                    </p>
                }
            </div>
        </div>
    </div>
</div>

